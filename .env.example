# Resolution Bingo - Environment Configuration
# Copy this file to .env and fill in your values

# MariaDB Database Connection
#DB_HOST=host.docker.internal           # When launched from within devcontainer
DB_HOST=localhost                       # When launched from host machine
DB_PORT=1234
DB_USER=your_username
DB_PASSWORD=your_password
DB_ROOT_PASSWORD=your_root_password
DB_NAME=db_name

# Password Hashing
PASSWORD_SALT_ROUNDS=10

# Next.js Environment
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0

# SMTP Configuration
SMTP_HOST=your.email.provider
SMTP_PORT=1234
SMTP_SECURE=false
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=noreply@yourdomain.com
APP_BASE_URL=http://localhost               # Used for generating verification links in emails
